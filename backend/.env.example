# ── Server ──
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ── Database (Neon) ──
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/zencom?sslmode=require

# ── Auth (Better Auth) ── generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# 32-byte key (64 hex chars) used to encrypt integration tokens. Falls back to a key derived from BETTER_AUTH_SECRET.
ENCRYPTION_KEY=

# ── OpenAI ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Cheap model used for query rewriting + LLM-as-judge evals
OPENAI_FAST_MODEL=gpt-4.1-mini

# ── Pinecone ── (serverless index, dimension 1536, cosine — created automatically if missing)
PINECONE_API_KEY=
PINECONE_INDEX=zencom
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── Cloudflare R2 ── (if empty, files are stored in ./uploads for local dev)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=zencom-documents

# ── Trigger.dev ── (if TRIGGER_SECRET_KEY is empty, jobs run in-process)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=proj_tzvztbqfbskcqpbfihda

# ── HubSpot OAuth app ── redirect URL: {BACKEND_URL}/api/integrations/hubspot/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# ── Slack OAuth app ── redirect URL: {BACKEND_URL}/api/integrations/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── Linear OAuth app ── redirect URL: {BACKEND_URL}/api/integrations/linear/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# ── Email (Resend) ── team invitations. Without a key, invites fall back to a copyable link.
# EMAIL_FROM must use a domain verified in Resend (onboarding@resend.dev only delivers to your own address).
RESEND_API_KEY=
EMAIL_FROM=Zencom <team@yourdomain.com>

# ── Billing (Razorpay Subscriptions) ──
# Create two monthly plans in Razorpay Dashboard → Subscriptions → Plans and paste their plan_ ids.
# Webhook URL: {BACKEND_URL}/webhooks/razorpay — events: subscription.*, payment.failed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=

# ── Langfuse ── tracing + online/offline evals. EU: https://cloud.langfuse.com  US: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_EVAL_SAMPLE_RATE=0.3

# ── RAG tuning (optional) ──
RAG_RERANK_MODEL=bge-reranker-v2-m3
RAG_CANDIDATES=20
RAG_TOP_K=6
RAG_MIN_RERANK_SCORE=0.08
RAG_MIN_VECTOR_SCORE=0.3
RAG_CONTEXT_TOKENS=3000
