generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Better Auth core ─────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  sessions          Session[]
  accounts          Account[]
  members           Member[]
  invitations       Invitation[]
  assignedConvos    Conversation[]   @relation("ConversationAssignee")
  assignedTickets   Ticket[]         @relation("TicketAssignee")
  messages          Message[]
  ticketActivities  TicketActivity[]
  uploadedDocuments Document[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────── Better Auth organization = Zencom Workspace ───────────────

model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  members       Member[]
  invitations   Invitation[]
  settings      WorkspaceSettings?
  customers     Customer[]
  conversations Conversation[]
  tickets       Ticket[]
  documents     Document[]
  integrations  Integration[]
  subscription  Subscription?

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ───────────────────────────── Zencom domain ─────────────────────────────

model WorkspaceSettings {
  id                  String       @id @default(cuid())
  workspaceId         String       @unique
  publicKey           String       @unique
  businessName        String?
  businessDescription String?
  website             String?
  supportEmail        String?
  aiEnabled           Boolean      @default(true)
  aiName              String       @default("Zen")
  aiInstructions      String?
  confidenceThreshold Float        @default(0.55)
  autoCreateTickets   Boolean      @default(true)
  widgetColor         String       @default("#0052f2")
  widgetGreeting      String       @default("Hi there! How can we help you today?")
  widgetPosition      String       @default("right")
  askForEmail         Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  workspace           Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum Channel {
  WEB
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
}

enum MessageRole {
  CUSTOMER
  AI
  AGENT
  SYSTEM
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum IntegrationProvider {
  HUBSPOT
  SLACK
  LINEAR
}

model Customer {
  id            String         @id @default(cuid())
  workspaceId   String
  visitorId     String?
  name          String?
  email         String?
  phone         String?
  crmContactId  String?
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastSeenAt    DateTime       @default(now())
  workspace     Organization   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  tickets       Ticket[]

  @@unique([workspaceId, visitorId])
  @@index([workspaceId, email])
}

model Conversation {
  id                 String             @id @default(cuid())
  workspaceId        String
  customerId         String
  channel            Channel            @default(WEB)
  status             ConversationStatus @default(OPEN)
  aiActive           Boolean            @default(true)
  assigneeId         String?
  subject            String?
  escalatedAt        DateTime?
  escalationReason   String?
  lastMessageAt      DateTime           @default(now())
  lastMessagePreview String?
  unreadCount        Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  workspace          Organization       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignee           User?              @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages           Message[]
  tickets            Ticket[]

  @@index([workspaceId, status, lastMessageAt])
  @@index([customerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  authorId       String?
  externalId     String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([externalId])
}

model Ticket {
  id                 String           @id @default(cuid())
  number             Int              @default(autoincrement())
  workspaceId        String
  conversationId     String?
  customerId         String?
  title              String
  description        String
  category           String           @default("general")
  priority           TicketPriority   @default(MEDIUM)
  status             TicketStatus     @default(OPEN)
  proposedResolution String?
  createdByAi        Boolean          @default(false)
  assigneeId         String?
  externalLinks      Json?
  resolvedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  workspace          Organization     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation       Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customer           Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignee           User?            @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  activities         TicketActivity[]

  @@index([workspaceId, status, createdAt])
  @@index([conversationId])
}

model TicketActivity {
  id        String   @id @default(cuid())
  ticketId  String
  actorId   String?
  type      String
  message   String
  data      Json?
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

model Document {
  id           String         @id @default(cuid())
  workspaceId  String
  name         String
  mimeType     String
  size         Int
  storageKey   String
  status       DocumentStatus @default(UPLOADED)
  error        String?
  chunkCount   Int            @default(0)
  version      Int            @default(1)
  uploadedById String?
  indexedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  workspace    Organization   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy   User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

model Integration {
  id                  String              @id @default(cuid())
  workspaceId         String
  provider            IntegrationProvider
  status              String              @default("connected")
  credentials         String
  config              Json?
  externalAccountId   String?
  externalAccountName String?
  connectedById       String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  workspace           Organization        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([provider, externalAccountId])
}

// ───────────────────────────── Billing (Razorpay) ─────────────────────────────

/**
 * One row per workspace. plan = "free" | "starter" | "growth"; status mirrors Razorpay subscription status.
 */
model Subscription {
  id                     String       @id @default(cuid())
  workspaceId            String       @unique
  plan                   String       @default("free")
  status                 String       @default("active")
  razorpaySubscriptionId String?      @unique
  razorpayPlanId         String?
  razorpayCustomerId     String?
  shortUrl               String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean      @default(false)
  lastPaymentId          String?
  lastPaymentAt          DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  workspace              Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/**
 * Processed Razorpay webhook events (x-razorpay-event-id) — makes webhook handling idempotent.
 */
model BillingEvent {
  id          String   @id
  type        String
  workspaceId String?
  payload     Json
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
}
